<UserControl x:Class="Codice.Desktop.Views.StudentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource ScreenRoot}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Listado de estudiantes" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Buscar por código o nombre" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" AutomationProperties.Name="Buscar estudiante" />
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Height="355"><DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Código" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Nombres" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Apellidos" Binding="{Binding LastName}" Width="*" />
                </DataGrid.Columns></DataGrid>
                <TextBlock Text="Selecciona una fila para editar. Usa Nuevo para registrar otra ficha." Style="{StaticResource MutedText}" Margin="0,14,0,0" />
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
                <TextBlock Text="Ficha del estudiante" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Código *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="{StaticResource FieldGap}" AutomationProperties.Name="Código de estudiante" />
                <TextBlock Text="Nombres *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldGap}" AutomationProperties.Name="Nombres" />
                <TextBlock Text="Apellidos *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldGap}" AutomationProperties.Name="Apellidos" />
                <TextBlock Text="* Obligatorio. El código no cambia al editar." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
                <Button Content="Guardar estudiante" Command="{Binding SaveCommand}" Margin="0,0,0,10" />
                <Button Content="Nuevo" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel></Border>
            
        </Grid>
    </ScrollViewer>
</UserControl>
