<UserControl x:Class="Codice.Desktop.Views.GradesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Style="{StaticResource ScreenRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Curso *" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding Course}" DisplayMemberPath="Display" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Evaluación *" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Assessments}" SelectedItem="{Binding Assessment}" DisplayMemberPath="Name" /></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Notas de la evaluación" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Height="330"><DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Estudiante" Binding="{Binding Student}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Nota" Binding="{Binding Value}" Width="110" />
                </DataGrid.Columns></DataGrid><TextBlock Text="Pendiente significa que todavía no se ha registrado una nota." Style="{StaticResource MutedText}" Margin="0,14,0,0" />
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
                <TextBlock Text="Registrar o corregir" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Estudiante *" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Enrollments}" SelectedItem="{Binding Enrollment}" DisplayMemberPath="Student" Margin="{StaticResource FieldGap}" />
                <TextBlock Text="Nota * · 1,0 a 7,0" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldGap}" />
                <TextBlock Text="Una cifra decimal. Ejemplo: 5,4." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
                <Button Content="Registrar nota" Command="{Binding RegisterCommand}" Margin="0,0,0,10" /><Button Content="Corregir nota" Command="{Binding CorrectCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel></Border>
        </Grid>
        
    </Grid></ScrollViewer>
</UserControl>
