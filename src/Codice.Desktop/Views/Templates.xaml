<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Codice.Desktop.ViewModels"
                    xmlns:views="clr-namespace:Codice.Desktop.Views">
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StudentsViewModel}"><views:StudentsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SubjectsViewModel}"><views:SubjectsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CoursesViewModel}"><views:CoursesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GradesViewModel}"><views:GradesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AttendanceViewModel}"><views:AttendanceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
</ResourceDictionary>
