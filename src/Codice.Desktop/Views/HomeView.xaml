<UserControl x:Class="Codice.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource ScreenRoot}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <UniformGrid Columns="3" Margin="0,0,0,22">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="ESTUDIANTES" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding StudentCount}" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="ASIGNATURAS" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding SubjectCount}" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CURSOS" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding CourseCount}" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Tus cursos" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Courses}" Height="260"><DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Asignatura" Binding="{Binding Subject}" Width="*" />
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Sección" Binding="{Binding Section}" Width="90" />
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Período" Binding="{Binding Period}" Width="110" />
                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Estudiantes" Binding="{Binding Students}" Width="115" />
                </DataGrid.Columns></DataGrid>
                <TextBlock Text="Si la lista está vacía, registra una asignatura y crea su primer curso." Style="{StaticResource MutedText}" Margin="0,14,0,0" />
            </StackPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,22,0,0"><StackPanel>
                <TextBlock Text="Un recorrido sencillo" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="1. Registra estudiantes y asignaturas.  2. Prepara cursos, matrículas y actividades.  3. Ingresa notas y asistencia.  4. Consulta los informes." Style="{StaticResource MutedText}" />
            </StackPanel></Border>
            
        </Grid>
    </ScrollViewer>
</UserControl>
