<Window x:Class="Codice.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Códice · Gestión académica" Width="1280" Height="900" MinWidth="1100" MinHeight="740"
        WindowStartupLocation="CenterScreen" Language="es-CL" Style="{StaticResource {x:Type Window}}">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="18,30,18,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="14,0,0,36">
                    <TextBlock Text="Códice" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="GESTIÓN ACADÉMICA" FontSize="10" Foreground="{StaticResource SidebarTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Title}" Command="{Binding Command}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Margin="14,0,0,0">
                    <TextBlock Text="Tu información, organizada." Foreground="{StaticResource SidebarTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Datos locales" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Current.Description}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    <Border DataContext="{Binding Current}" Style="{StaticResource Message}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" />
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding Current}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
